# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE: Required for PostgreSQL database, authentication, and file storage.
# Obtain these from your Supabase Project Settings -> API.
# VITE_SUPABASE_URL: e.g. https://xyzcompany.supabase.co
VITE_SUPABASE_URL=""
# VITE_SUPABASE_ANON_KEY: Your public anon key for Supabase client
VITE_SUPABASE_ANON_KEY=""
